---
import Docs from "../../layouts/Docs.astro";
import { Code } from "astro:components";

// The quickstart's app, cut to its shape.
const example = `use wove::{elements::{Input, Text}, terminal, Key, Tree};

fn main() -> Result<(), Box<dyn std::error::Error>> {
    let mut tree = Tree::new();
    tree.add(tree.root(), Text::new("Your name?"))?;
    let input = tree.add(tree.root(), Input::default())?;
    tree.focus(Some(input))?;

    // Draw the tree and route input until Escape.
    terminal::run(&mut tree, |_, event, _| *event != Key::Escape.into())?;
    Ok(())
}`;
---

<Docs
  title="Introduction"
  description="A Rust library for building terminal user interfaces."
>
  <p>
    Wove is a Rust library for building terminal user interfaces. You build a
    tree of elements, lay it out with flexbox or grid, and Wove draws it and
    routes keyboard and mouse input.
  </p>

  <Code
    code={example}
    lang="rust"
    themes={{ light: "github-light", dark: "github-dark" }}
    wrap
  />

  <p>
    That's a complete app: a label and a text field with cursor movement,
    selection, and undo. The <a href="/docs/quickstart/">quickstart</a> builds
    it step by step.
