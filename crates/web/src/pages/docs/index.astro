---
import Page from "../../layouts/Page.astro";
import { getCollection } from "astro:content";
const guides = (await getCollection("docs")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Page title="Documentation">
  <p class="eyebrow">Documentation</p>
  <h1>Development docs.</h1>
  <p>
    Wove is in early development. These guides describe the current source
    checkout, version 0.0.1.
  </p>
  {guides.map((guide) => (
    <section>
      <h2>
        <a href={`/docs/${guide.id}/`}>{guide.data.title} →</a>
      </h2>
      <p>{guide.data.description}</p>
    </section>
  ))}
</Page>
