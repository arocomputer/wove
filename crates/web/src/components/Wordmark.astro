---
// Inline geometry paints with the page and chooses its color without JavaScript.
---

<svg
  class="wove-mark"
  width="170"
  height="40"
  viewBox="0 0 170 40"
  role="img"
  aria-label="Wove"
  xmlns="http://www.w3.org/2000/svg"
>
  <style is:inline>
    .wove-mark {
      display: block;
      max-width: 100%;
      fill: #171717;
    }
    @media (prefers-color-scheme: dark) {
      .wove-mark {
        fill: #ededed;
      }
    }
  </style>
  <path
    fill-rule="evenodd"
    clip-rule="evenodd"
    d="M60 0H90V40H60V0ZM80 10H70V30H80V10Z"
  />
